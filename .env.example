# Telegram MTProto (Telethon) - для читання публічних каналів
# Отримайте API ID та HASH на https://my.telegram.org
TELETHON_API_ID=
TELETHON_API_HASH=
# Згенерована сесія через `python -m src.telegram.generate_session`
# Дозволяє контейнеру працювати без файлів сесії на ефемерних хостингах (Render, Koyeb, OCI)
TELETHON_STRING_SESSION=

# Telegram Bot Token (Aiogram) - для відправки пушів підписникам
# Отримайте через @BotFather
TELEGRAM_BOT_TOKEN=

# Список моніторингових каналів для відстеження (через кому або у форматі JSON)
MONITORED_CHANNELS=["monitoring_zaxid", "kudy_letyt", "monitorwarr"]

# Профіль міста (файл data/profiles/<імʼя>.json). Див. docs/ADAPTING.md
CITY_PROFILE=ivano-frankivsk
# Необовʼязково: перевизначити регіон офіційних тривог із профілю
# SIREN_REGION=

# Шляхи до даних
REFERENCE_DIR=data/reference
LEARNING_DB_PATH=data/learning.db
SUBSCRIBERS_DB_PATH=data/subscribers.db

# Налаштування вбудованого веб-сервера (healthcheck / UptimeRobot)
API_HOST=0.0.0.0
API_PORT=8080
